    "zod": "4.6.5",
    "node-xlsx": "0.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^7",
    "prisma": "7.10.0",
    "tsx": "4.23.13"
  },
  "engines": {
    "node": ">=22 <23"
